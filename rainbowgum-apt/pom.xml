<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>io.jstach.rainbowgum</groupId>
    <artifactId>rainbowgum-maven-parent</artifactId>
    <version>1.0.0-SNAPSHOT</version>
  </parent>
  <artifactId>rainbowgum-apt</artifactId>
  <name>rainbowgum-apt</name>
  <properties>
    <doc.resources>../</doc.resources>
    <parent.root>${basedir}/..</parent.root>
  </properties>
  <dependencies>
    <dependency>
      <groupId>io.jstach.rainbowgum</groupId>
      <artifactId>rainbowgum-annotation</artifactId>
      <optional>true</optional>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>io.jstach</groupId>
      <artifactId>jstachio-annotation</artifactId>
      <optional>true</optional>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>io.jstach</groupId>
      <artifactId>jstachio-apt</artifactId>
      <optional>true</optional>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>io.jstach.pistachio</groupId>
      <artifactId>pistachio-prism</artifactId>
    </dependency>
    <dependency>
      <groupId>io.jstach.pistachio</groupId>
      <artifactId>pistachio-prism-apt</artifactId>
    </dependency>
    <dependency>
      <groupId>org.eclipse.jdt</groupId>
      <artifactId>org.eclipse.jdt.annotation</artifactId>
      <version>2.4.100</version>
      <optional>true</optional>
      <scope>provided</scope>
      <!--
        Not used by any of this module's own source (that is org.jspecify.annotations,
        same as everywhere else) - pistachio-prism-apt 0.1.2 hardcodes
        org.eclipse.jdt.annotation.Nullable into the *Prism.java classes it generates
        (LogConfigurablePrism, KeyParameterPrism, etc., under
        target/generated-sources/annotations), so this module alone still needs it on
        its compile classpath for those to resolve. Scoped here rather than in the root
        pom precisely so it stays that narrow - no other module needs it.
      -->
    </dependency>
    <dependency>
      <groupId>io.jstach.pistachio</groupId>
      <artifactId>pistachio-svc</artifactId>
    </dependency>
    <dependency>
      <groupId>io.jstach.pistachio</groupId>
      <artifactId>pistachio-svc-apt</artifactId>
    </dependency>
  </dependencies>
  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <!--
            This module has a real module-info.java (compiled normally, no moditect
            post-processing). Left to automatic ServiceLoader-based discovery, javac
            would try to run every processor it finds on the processor path - including
            this module's own ConfigProcessor, via its own module-info `provides
            javax.annotation.processing.Processor with ...ConfigProcessor` clause -
            against this module's own not-yet-compiled sources, which fails since
            ConfigProcessor's class file does not exist yet. Explicitly naming exactly
            the two processors this module's own sources actually need bypasses
            automatic discovery entirely (javac's own semantics: an explicit -processor
            list replaces ServiceLoader scanning, it does not add to it), so
            ConfigProcessor is never a candidate to load in the first place. Both
            classes below are already-compiled, external classes from the
            pistachio-prism-apt/pistachio-svc-apt dependencies, not part of this
            compilation, so there is no self-reference.
          -->
          <annotationProcessors>
            <!-- pistachio-prism-apt: generates the *Prism.java classes ConfigProcessor
              itself uses, from the @GeneratePrisms on
              io.jstach.rainbowgum.apt.prism.package-info. -->
            <annotationProcessor>io.jstach.prism.apt.PrismGenerator</annotationProcessor>
            <!-- pistachio-svc-apt: generates ConfigProcessor's own
              META-INF/services/javax.annotation.processing.Processor registration,
              from its @ServiceProvider annotation. -->
            <annotationProcessor>io.jstach.svc.apt.ServiceProcessor</annotationProcessor>
            <!-- jstachio-apt: renders BuilderModel's own @JStache(path =
              "io/jstach/rainbowgum/apt/ConfigBuilder.java") template into
              BuilderModelRenderer, which ConfigProcessor uses directly. -->
            <annotationProcessor>io.jstach.apt.GenerateRendererProcessor</annotationProcessor>
          </annotationProcessors>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-javadoc-plugin</artifactId>
        <configuration>
          <additionalOptions>
            <additionalOption>--allow-script-in-comments</additionalOption>
            <additionalOption>--snippet-path ${project.basedir}/${doc.resources}${doc.snippets}</additionalOption>
            <additionalOption>--add-stylesheet ${parent.root}/doc/jstachio.css</additionalOption>
            <additionalOption>--link-modularity-mismatch info</additionalOption>
          </additionalOptions>
        </configuration>
      </plugin>
    </plugins>
  </build>
  <profiles>
    <profile>
      <id>doc</id>
      <properties>
        <maven.javadoc.skip>true</maven.javadoc.skip>
      </properties>
    </profile>
  </profiles>
</project>
