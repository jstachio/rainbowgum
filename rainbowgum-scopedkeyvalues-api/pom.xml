<project xmlns="http://maven.apache.org/POM/4.0.0"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>io.jstach.rainbowgum</groupId>
    <artifactId>rainbowgum-maven-parent</artifactId>
    <version>1.0.0-SNAPSHOT</version>
  </parent>
  <artifactId>rainbowgum-scopedkeyvalues-api</artifactId>
  <name>rainbowgum-scopedkeyvalues-api</name>
  <properties>
    <doc.resources>../</doc.resources>
    <parent.root>${basedir}/..</parent.root>
    <!--
      Deliberately does NOT override java.version like rainbowgum-scopedkeyvalues does:
      this module never references java.lang.ScopedValue (or anything else JDK 25+)
      directly, only java.util.ServiceLoader and plain interfaces/Map, so it stays on the
      project's usual baseline and is safe to compile against from any consumer, not just
      ones already on JDK 25+. A provider module supplies the actual ScopedValue-backed
      implementation at runtime.
    -->
  </properties>
  <!-- Maven coordinates are source-only documentation; no runtime dependency is added. -->
  <dependencies>
    <dependency>
      <groupId>${project.groupId}</groupId>
      <artifactId>rainbowgum-annotation</artifactId>
      <scope>provided</scope>
    </dependency>
  </dependencies>
</project>
