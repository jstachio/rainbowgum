<project xmlns="http://maven.apache.org/POM/4.0.0"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>io.jstach.rainbowgum</groupId>
    <artifactId>rainbowgum-maven-parent</artifactId>
    <version>0.11.0-SNAPSHOT</version>
  </parent>
  <artifactId>rainbowgum-spring-parent</artifactId>
  <name>rainbowgum-spring-parent</name>
  <packaging>pom</packaging>
  <properties>
    <doc.resources>../</doc.resources>
    <parent.root>${basedir}/..</parent.root>
  </properties>
  <!--
    Deliberately no shared spring-boot.version property, dependencyManagement, or
    spring-boot-maven-plugin pluginManagement here: rainbowgum-spring-boot3 and
    rainbowgum-spring-boot4 (and their starters) each pin their own Spring Boot major
    version independently and must never share one, otherwise bumping one would
    silently bump the other.
  -->
  <modules>
    <module>rainbowgum-spring-spi</module>
    <module>rainbowgum-spring-boot3</module>
    <module>rainbowgum-spring-boot3-starter</module>
    <module>rainbowgum-spring-boot4</module>
    <module>rainbowgum-spring-boot4-starter</module>
  </modules>
</project>
