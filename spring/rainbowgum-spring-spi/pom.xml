<project xmlns="http://maven.apache.org/POM/4.0.0"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>io.jstach.rainbowgum</groupId>
    <artifactId>rainbowgum-spring-parent</artifactId>
    <version>0.11.0-SNAPSHOT</version>
  </parent>
  <artifactId>rainbowgum-spring-spi</artifactId>
  <name>rainbowgum-spring-spi</name>
  <properties>
    <!--
      Deliberately compiled against a pinned, old-ish spring-core version (provided scope,
      no spring-boot-dependencies BOM import) rather than either Spring Boot major version's
      BOM: this module is shared by both rainbowgum-spring-boot3 and rainbowgum-spring-boot4,
      and org.springframework.core.env.Environment - the only Spring type this module uses -
      has been stable since Spring Framework 3.1. The real spring-core version is supplied
      transitively at runtime by whichever of the two boot modules is actually on the
      classpath.
    -->
    <spring-core.version>6.1.12</spring-core.version>
    <doc.resources>../../</doc.resources>
    <parent.root>${basedir}/../..</parent.root>
  </properties>
  <dependencies>
    <dependency>
      <groupId>${project.groupId}</groupId>
      <artifactId>rainbowgum-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework</groupId>
      <artifactId>spring-core</artifactId>
      <version>${spring-core.version}</version>
      <scope>provided</scope>
    </dependency>
  </dependencies>
</project>
