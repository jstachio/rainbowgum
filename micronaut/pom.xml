<project xmlns="http://maven.apache.org/POM/4.0.0"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>io.jstach.rainbowgum</groupId>
    <artifactId>rainbowgum-maven-parent</artifactId>
    <version>1.0.0-SNAPSHOT</version>
  </parent>
  <groupId>io.jstach.rainbowgum.micronaut</groupId>
  <artifactId>rainbowgum-micronaut-parent</artifactId>
  <name>rainbowgum-micronaut-parent</name>
  <packaging>pom</packaging>
  <properties>
    <doc.resources>../</doc.resources>
    <parent.root>${basedir}/..</parent.root>
  </properties>
  <!--
    Its own groupId (io.jstach.rainbowgum.micronaut), matching rainbowgum-helidon's own
    reasoning: Micronaut major versions force a new artifact each time (this project
    ships one shared version across every module, so an upstream-driven break can't
    otherwise be expressed as anything other than a new artifact), and a dedicated
    groupId keeps the door open to moving this out to its own repository later with no
    consumer-facing coordinate change.
  -->
  <modules>
    <module>rainbowgum-micronaut5</module>
  </modules>
</project>
