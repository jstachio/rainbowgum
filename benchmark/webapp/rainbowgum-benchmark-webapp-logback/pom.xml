<project xmlns="http://maven.apache.org/POM/4.0.0"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>io.jstach.rainbowgum</groupId>
    <artifactId>rainbowgum-benchmark-webapp-parent</artifactId>
    <version>0.10.0-SNAPSHOT</version>
  </parent>
  <artifactId>rainbowgum-benchmark-webapp-logback</artifactId>
  <properties>
    <parent.root>${basedir}/../../..</parent.root>
  </properties>
  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <executions>
          <execution>
            <goals>
              <goal>repackage</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
  <dependencies>
    <!--
      spring-boot-starter-web pulls in spring-boot-starter-logging (Logback) by default:
      this app is the baseline/control, deliberately left untouched.
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>${project.groupId}</groupId>
      <artifactId>rainbowgum-benchmark-webapp-share</artifactId>
    </dependency>
  </dependencies>
</project>
