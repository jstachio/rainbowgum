<project xmlns="http://maven.apache.org/POM/4.0.0"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>io.jstach.rainbowgum</groupId>
    <artifactId>rainbowgum-benchmark-webapp-parent</artifactId>
    <version>0.10.0-SNAPSHOT</version>
  </parent>
  <artifactId>rainbowgum-benchmark-webapp-rainbowgum</artifactId>
  <properties>
    <parent.root>${basedir}/../../..</parent.root>
  </properties>
  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <executions>
          <execution>
            <goals>
              <goal>repackage</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
      <exclusions>
        <exclusion>
          <groupId>org.springframework.boot</groupId>
          <artifactId>spring-boot-starter-logging</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>io.jstach.rainbowgum</groupId>
      <artifactId>rainbowgum-spring-boot4-starter</artifactId>
      <version>${project.version}</version>
      <exclusions>
        <!--
          rainbowgum-jansi (pulled in transitively via the rainbowgum umbrella artifact)
          wraps System.out in org.jline's AnsiOutputStream for colored console output,
          whose write() path processes bytes one at a time - confirmed via JFR to cost
          single-digit milliseconds per log line and dominate this app's request latency.
          Excluded here both to keep the comparison to Logback/Log4j2 (whose Spring Boot
          console coloring embeds escape codes directly, no stream wrapper) apples-to-apples,
          and because it's not on by default anyway going forward.
        -->
        <exclusion>
          <groupId>io.jstach.rainbowgum</groupId>
          <artifactId>rainbowgum-jansi</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>${project.groupId}</groupId>
      <artifactId>rainbowgum-benchmark-webapp-share</artifactId>
    </dependency>
    <!--
      rainbowgum-spring-boot4-starter only exposes these at runtime scope (a starter's
      consumers normally don't need compile-time access to its internals), but
      GelfSpringRainbowGumServiceProvider needs LogConfig/RainbowGum/OutputType,
      SpringRainbowGumServiceProvider, and GelfEncoder at compile time. All three are
      already on the runtime classpath transitively; this just adds compile-time visibility.
    -->
    <dependency>
      <groupId>${project.groupId}</groupId>
      <artifactId>rainbowgum-core</artifactId>
    </dependency>
    <dependency>
      <groupId>${project.groupId}</groupId>
      <artifactId>rainbowgum-spring-spi</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>${project.groupId}</groupId>
      <artifactId>rainbowgum-json</artifactId>
    </dependency>
  </dependencies>
</project>
