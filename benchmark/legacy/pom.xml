<project xmlns="http://maven.apache.org/POM/4.0.0"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>io.jstach.rainbowgum</groupId>
    <artifactId>rainbowgum-benchmark-parent</artifactId>
    <version>0.11.0-SNAPSHOT</version>
  </parent>
  <artifactId>rainbowgum-benchmark-legacy-parent</artifactId>
  <packaging>pom</packaging>
  <properties>
    <parent.root>${basedir}/../..</parent.root>
  </properties>
  <!--
    The original hand-rolled micro-benchmarks (tight-loop Logger.error(...) calls, no
    HTTP layer, no Spring Boot) - kept separate from benchmark/webapp's real Spring Boot
    apps specifically so their dependencyManagement (logback-classic/log4j-slf4j2-impl
    pins below) can never again leak into and override a descendant's Spring Boot BOM the
    way it once did when both lived as siblings under benchmark/pom.xml directly - see
    that incident in benchmark/webapp/FINDINGS.md history. Nothing under benchmark/webapp
    inherits from this pom.
  -->
  <modules>
    <module>rainbowgum-benchmark-logback</module>
    <module>rainbowgum-benchmark-rainbowgum</module>
    <module>rainbowgum-benchmark-share</module>
    <module>rainbowgum-benchmark-log4j</module>
  </modules>
  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>${project.groupId}</groupId>
        <artifactId>rainbowgum-benchmark-share</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>ch.qos.logback</groupId>
        <artifactId>logback-classic</artifactId>
        <version>1.5.12</version>
      </dependency>
      <dependency>
        <groupId>org.apache.logging.log4j</groupId>
        <artifactId>log4j-slf4j2-impl</artifactId>
        <version>3.0.0-beta2</version>
      </dependency>
    </dependencies>
  </dependencyManagement>
  <dependencies>
  </dependencies>
</project>
