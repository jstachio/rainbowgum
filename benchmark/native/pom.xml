<project xmlns="http://maven.apache.org/POM/4.0.0"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>io.jstach.rainbowgum</groupId>
    <artifactId>rainbowgum-benchmark-parent</artifactId>
    <version>0.12.0-SNAPSHOT</version>
  </parent>
  <artifactId>rainbowgum-benchmark-native-parent</artifactId>
  <packaging>pom</packaging>
  <properties>
    <parent.root>${basedir}/../..</parent.root>
    <!--
      No Spring Boot BOM here (unlike benchmark/webapp) - deliberately: each app is a
      plain com.sun.net.httpserver.HttpServer main class, so there is nothing to compare
      except the logging backend itself, and no web framework's own GraalVM native-image
      support (or lack of it) to control for.
    -->
  </properties>
  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>${project.groupId}</groupId>
        <artifactId>rainbowgum-benchmark-native-share</artifactId>
        <version>${project.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>
  <modules>
    <module>rainbowgum-benchmark-native-share</module>
    <module>rainbowgum-benchmark-native-driver</module>
    <module>rainbowgum-benchmark-native-rainbowgum</module>
    <module>rainbowgum-benchmark-native-log4j2</module>
    <module>rainbowgum-benchmark-native-logback</module>
  </modules>
</project>
