<project xmlns="http://maven.apache.org/POM/4.0.0"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>io.jstach.rainbowgum</groupId>
    <artifactId>rainbowgum-benchmark-native-parent</artifactId>
    <version>0.12.0-SNAPSHOT</version>
  </parent>
  <artifactId>rainbowgum-benchmark-native-rainbowgum</artifactId>
  <properties>
    <parent.root>${basedir}/../../..</parent.root>
    <native.maven.plugin.version>0.10.6</native.maven.plugin.version>
    <exec.mainClass>io.jstach.rainbowgum.benchmark.nativeimage.rainbowgum.App</exec.mainClass>
  </properties>
  <dependencies>
    <dependency>
      <groupId>${project.groupId}</groupId>
      <artifactId>rainbowgum-benchmark-native-share</artifactId>
    </dependency>
    <dependency>
      <groupId>${project.groupId}</groupId>
      <artifactId>rainbowgum-slf4j</artifactId>
    </dependency>
  </dependencies>
  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <configuration>
          <archive>
            <manifest>
              <addClasspath>true</addClasspath>
              <mainClass>${exec.mainClass}</mainClass>
              <classpathPrefix>${exec.classpathPrefix}</classpathPrefix>
              <classpathLayoutType>repository</classpathLayoutType>
              <useUniqueVersions>false</useUniqueVersions>
            </manifest>
          </archive>
        </configuration>
      </plugin>
    </plugins>
  </build>
  <profiles>
    <profile>
      <!--
        Same template as test/rainbowgum-test-native/pom.xml - see that module's own
        comments for why compile-no-fork (not the test goal) and why no buildArgs are
        needed for Rainbow Gum's own classes.
      -->
      <id>native</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.graalvm.buildtools</groupId>
            <artifactId>native-maven-plugin</artifactId>
            <version>${native.maven.plugin.version}</version>
            <extensions>true</extensions>
            <executions>
              <execution>
                <id>native-compile</id>
                <phase>package</phase>
                <goals>
                  <goal>compile-no-fork</goal>
                </goals>
                <configuration>
                  <imageName>rainbowgum-benchmark-native-rainbowgum</imageName>
                  <mainClass>${exec.mainClass}</mainClass>
                  <fallback>false</fallback>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
