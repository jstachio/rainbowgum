<project xmlns="http://maven.apache.org/POM/4.0.0"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>io.jstach.rainbowgum</groupId>
    <artifactId>rainbowgum-maven-parent</artifactId>
    <version>0.11.0-SNAPSHOT</version>
  </parent>
  <artifactId>rainbowgum-benchmark-parent</artifactId>
  <packaging>pom</packaging>
  <properties>
    <parent.root>${basedir}/../..</parent.root>
    <exec.classpathPrefix>${settings.localRepository}</exec.classpathPrefix>
    <maven.javadoc.skip>true</maven.javadoc.skip>
    <skipNexusStagingDeployMojo>true</skipNexusStagingDeployMojo>
  </properties>
  <!--
    legacy (the original hand-rolled micro-benchmarks) and webapp (real Spring Boot
    apps) are deliberately siblings with no shared dependencyManagement at this level -
    legacy's logback-classic/log4j-slf4j2-impl pins live in legacy/pom.xml now, scoped so
    they can never again leak into and override webapp's Spring Boot BOM the way they
    once did when everything shared this pom's dependencyManagement directly. See
    legacy/pom.xml and benchmark/webapp/FINDINGS.md for that history.
  -->
  <modules>
    <module>legacy</module>
    <module>webapp</module>
  </modules>
</project>
