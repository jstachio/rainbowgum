<project xmlns="http://maven.apache.org/POM/4.0.0"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>io.jstach.rainbowgum</groupId>
    <artifactId>rainbowgum-maven-parent</artifactId>
    <version>0.10.0-SNAPSHOT</version>
  </parent>
  <artifactId>rainbowgum-benchmark-parent</artifactId>
  <packaging>pom</packaging>
  <properties>
    <parent.root>${basedir}/../..</parent.root>
    <exec.classpathPrefix>${settings.localRepository}</exec.classpathPrefix>
    <maven.javadoc.skip>true</maven.javadoc.skip>
    <skipNexusStagingDeployMojo>true</skipNexusStagingDeployMojo>
  </properties>
  <modules>
    <module>rainbowgum-benchmark-logback</module>
    <module>rainbowgum-benchmark-rainbowgum</module>
    <module>rainbowgum-benchmark-share</module>
    <module>rainbowgum-benchmark-log4j</module>
    <module>webapp</module>
  </modules>
  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>${project.groupId}</groupId>
        <artifactId>rainbowgum-benchmark-share</artifactId>
        <version>${project.version}</version>
      </dependency>
      <!--
        Deliberately NOT managed here (moved into rainbowgum-benchmark-logback /
        rainbowgum-benchmark-log4j directly): dependencyManagement is inherited by every
        module under this parent, including webapp/, whose apps import the Spring Boot 4
        BOM and need its coordinated logback/log4j2 versions - an explicit pin here would
        silently override just the one artifact the BOM also manages (e.g. logback-classic)
        while leaving its transitive siblings (e.g. logback-core) on the BOM's newer
        version, causing a NoSuchMethodError from the resulting mismatch.
      -->
    </dependencies>
  </dependencyManagement>
  <dependencies>
  </dependencies>
</project>
