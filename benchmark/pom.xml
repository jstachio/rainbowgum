<project xmlns="http://maven.apache.org/POM/4.0.0"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>io.jstach.rainbowgum</groupId>
    <artifactId>rainbowgum-maven-parent</artifactId>
    <version>0.11.0-SNAPSHOT</version>
  </parent>
  <artifactId>rainbowgum-benchmark-parent</artifactId>
  <packaging>pom</packaging>
  <properties>
    <parent.root>${basedir}/../..</parent.root>
    <exec.classpathPrefix>${settings.localRepository}</exec.classpathPrefix>
    <maven.javadoc.skip>true</maven.javadoc.skip>
    <skipNexusStagingDeployMojo>true</skipNexusStagingDeployMojo>
  </properties>
  <modules>
    <module>rainbowgum-benchmark-logback</module>
    <module>rainbowgum-benchmark-rainbowgum</module>
    <module>rainbowgum-benchmark-share</module>
    <module>rainbowgum-benchmark-log4j</module>
    <module>webapp</module>
  </modules>
  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>${project.groupId}</groupId>
        <artifactId>rainbowgum-benchmark-share</artifactId>
        <version>${project.version}</version>
      </dependency>
      <!--
        logback-classic/log4j-slf4j2-impl versions moved down into the two
        micro-benchmark modules that actually need them (rainbowgum-benchmark-logback,
        rainbowgum-benchmark-log4j) instead of being pinned here. Pinning them at this
        level meant they also applied to descendants like benchmark/webapp's Spring Boot
        apps, which import Spring Boot's own BOM and need logback-classic/logback-core
        (a separate artifact this pin never covered) to resolve to matching paired
        versions from that BOM - a stale pin here silently won over the BOM's and broke
        Spring Boot startup with a logback-core/logback-classic version mismatch.
      -->
    </dependencies>
  </dependencyManagement>
  <dependencies>
  </dependencies>
</project>
