<project xmlns="http://maven.apache.org/POM/4.0.0"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!--
    Deliberately parented directly on micronaut-parent, not rainbowgum-maven-parent: not
    part of the normal reactor build, same reasoning as examples/micronaut (see that
    module's README). micronaut-inject-java's annotation processor fails under full JPMS
    modular compilation (see micronaut/rainbowgum-micronaut5/pom.xml's own note), and
    a Micronaut app module needs micronaut-parent's own build (shade/packaging) plumbing
    directly rather than through an import. Build/run with:

      ../../mvnw -q -f pom.xml clean package -DskipTests

    Needs Rainbow Gum installed in the local .m2 first (../../mvnw install from the repo
    root), since the rainbowgum-* dependencies below pin an exact 1.0.0-SNAPSHOT version
    rather than resolving from Central.
  -->
  <parent>
    <groupId>io.micronaut.platform</groupId>
    <artifactId>micronaut-parent</artifactId>
    <version>5.1.5</version>
  </parent>

  <groupId>io.jstach.rainbowgum.benchmark.micronaut</groupId>
  <artifactId>rainbowgum-benchmark-micronaut-parent</artifactId>
  <version>1.0.0-SNAPSHOT</version>
  <packaging>pom</packaging>

  <properties>
    <packaging>jar</packaging>
    <jdk.version>21</jdk.version>
    <release.version>21</release.version>
    <micronaut.version>5.1.5</micronaut.version>
    <micronaut.core.version>5.1.15</micronaut.core.version>
    <rainbowgum.version>1.0.0-SNAPSHOT</rainbowgum.version>
    <micronaut.aot.enabled>false</micronaut.aot.enabled>
    <micronaut.runtime>netty</micronaut.runtime>
  </properties>

  <modules>
    <module>rainbowgum-benchmark-micronaut-share</module>
    <module>rainbowgum-benchmark-micronaut-logback</module>
    <module>rainbowgum-benchmark-micronaut-rainbowgum</module>
    <module>rainbowgum-benchmark-micronaut-driver</module>
  </modules>

</project>
